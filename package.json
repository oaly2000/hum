{
  "name": "hum-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:pkgs": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm build:pkgs && pnpm --filter hum-example-basic dev",
    "build": "pnpm build:pkgs && pnpm --filter hum-example-basic build",
    "start": "pnpm --filter hum-example-basic start",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:standalone": "pnpm build && node tools/test-standalone-deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
