{
  "name": "hum-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:pkgs": "pnpm --filter \"./packages/*\" --filter \"!hum-store\" run build",
    "dev": "pnpm build:pkgs && pnpm --filter hum-docs dev",
    "build": "pnpm build:pkgs && pnpm --filter hum-docs build",
    "start": "pnpm --filter hum-docs start",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:integration": "vitest run --project integration",
    "test:standalone": "pnpm build:pkgs && pnpm --filter hum-docs exec vite build --mode standalone && node tools/test-standalone-deploy.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vite-plugin": "^1.63.2",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.150.0"
  }
}
