{
  "name": "@humjs/core",
  "version": "0.6.1",
  "type": "module",
  "description": "Hum core: islands runtime, Hono based file routing for Node.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/oaly2000/hum.git"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./runtime": {
      "types": "./dist/runtime/mod.d.ts",
      "default": "./dist/runtime/mod.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./routing": {
      "types": "./dist/routing/mod.d.ts",
      "default": "./dist/routing/mod.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.json",
    "clean": "node ../../tools/clean-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.13",
    "preact": "^11.0.1",
    "preact-render-to-string": "^6.8.0"
  },
  "devDependencies": {
    "tinyglobby": "^0.2.17"
  }
}
